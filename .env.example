# Copia a .env.local para desarrollo; en Vercel van en Settings → Environment Variables.
# Token de la demo de Auren AI que contiene la base de conocimiento del Valle de Tenza.
AUREN_DEMO_TOKEN=
# Opcional. Por defecto https://app.getaurenai.com
AUREN_BASE_URL=

# Supabase (solo la llave pública anon). Sin estas variables la app usa el JSON local de lugares.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
