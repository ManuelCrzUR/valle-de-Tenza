# Copia a .env.local para desarrollo. En Vercel: Settings → Environment Variables.
# Todas estas variables son de SERVIDOR. No uses el prefijo VITE_: llegaría al navegador.

# OpenAI. Sin esta clave el plan se arma con el catálogo (modo demostración) y no se afirma una llamada.
# Ids leídos el 2026-11-06 en la documentación oficial (no son nombres inventados):
#   https://developers.openai.com/api/docs/models/gpt-6-luna  → gpt-6-luna, Responses supported
#   https://developers.openai.com/api/docs/models/gpt-transcribe → gpt-transcribe, /v1/audio/transcriptions supported
#   https://developers.openai.com/api/docs/guides/text-to-speech → ejemplo gpt-4o-mini-tts y voz coral;
#     tts-1, tts-1-hd y gpt-4o-mini-tts se apagan el 2027-01-06.
#     gpt-realtime-2.1-mini no sirve para /v1/audio/speech.
OPENAI_API_KEY=
OPENAI_ITINERARY_MODEL=gpt-6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Supabase. Solo la service role, en el servidor. No crees VITE_SUPABASE_ANON_KEY para estas tablas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend. El correo sale solo al pulsar «Enviar solicitud».
# RESEND_FROM_EMAIL debe ser un remitente del dominio verificado (o el remitente de prueba de tu cuenta).
# RESEND_ALLOWED_DOMAIN, si se llena, rechaza destinatarios de otros dominios (útil en clase).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_ALLOWED_DOMAIN=

# Chat heredado de Auren. El plan nuevo no lo usa. Si lo activas, el token no va al navegador.
AUREN_DEMO_TOKEN=
AUREN_BASE_URL=
